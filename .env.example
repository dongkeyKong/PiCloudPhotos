# ==============================================================================
# PiCloud Photos + Tailscale Zero-Trust Security Configuration
# ==============================================================================

# Software release version (Pinned stable release recommended)
IMMICH_VERSION=v1.121.0

# NVMe Mount Locations (Configured by setup-nvme.sh)
UPLOAD_LOCATION=/mnt/nvme/immich/upload
DB_DATA_LOCATION=/mnt/nvme/immich/postgres

# Database Credentials (Auto-generated by install.sh if left default)
DB_USERNAME=postgres
DB_PASSWORD=SecureFamilyPass2026!
DB_DATABASE_NAME=immich

# Tailscale Reusable Auth Key (Get from https://login.tailscale.com/admin/settings/keys)
# Optional: If blank, running 'docker exec -it immich_tailscale tailscale up' will give you an auth link in terminal!
TS_AUTHKEY=

# Local Home LAN IP binding (Set to 127.0.0.1 for localhost only, or your LAN IP)
LOCAL_LAN_IP=0.0.0.0

# Performance Tuning for Raspberry Pi 4 / 5:
# Smart search and facial recognition worker and thread constraints to prevent OOM
IMMICH_MACHINE_LEARNING_WORKERS=1
IMMICH_MACHINE_LEARNING_INTER_OP_THREADS=1
IMMICH_MACHINE_LEARNING_INTRA_OP_THREADS=2
IMMICH_MACHINE_LEARNING_ENABLED=true

# Optional: Push notifications for backups and disk alerts (e.g., https://ntfy.sh/my-picloud-alerts)
NTFY_TOPIC=
