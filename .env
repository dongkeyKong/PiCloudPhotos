# ==============================================================================
# PiCloud Photos + Tailscale Zero-Trust Security Configuration
# ==============================================================================

# Software release version
IMMICH_VERSION=release

# NVMe Mount Locations (Configured by setup-nvme.sh)
UPLOAD_LOCATION=/mnt/nvme/immich/upload
DB_DATA_LOCATION=/mnt/nvme/immich/postgres

# Database Credentials (Change to a unique random password!)
DB_USERNAME=postgres
DB_PASSWORD=SecureFamilyPass2026!
DB_DATABASE_NAME=immich

# Tailscale Reusable Auth Key (Get this from https://login.tailscale.com/admin/settings/keys)
# Optional: If left blank, running 'docker exec -it immich_tailscale tailscale up' will give you an auth link in terminal!
TS_AUTHKEY=

# Local Home LAN IP binding (Prevents accidental internet port exposure)
LOCAL_LAN_IP=0.0.0.0

# Performance Tuning for Raspberry Pi 5:
# Smart search and facial recognition enabled natively on ARM64
IMMICH_MACHINE_LEARNING_ENABLED=true
